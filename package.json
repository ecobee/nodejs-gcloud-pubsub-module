{
	"name": "@ecobee/nodejs-gcloud-pubsub-module",
	"version": "0.9.0",
	"description": "A GCloud Pub/Sub module for NestJS",
	"main": "index.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/ecobee/nodejs-gcloud-pubsub-module"
	},
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"author": "ecobee",
	"authors": [
		{
			"name": "Arvin Singla",
			"email": "arvins@ecobee.com"
		},
		{
			"name": "David D'Amico",
			"email": "david.damico@ecobee.com"
		},
		{
			"name": "Vikram Venkataramanan",
			"email": "231742443+vikram-ecobee@users.noreply.github.com"
		}
	],
	"keywords": [
		"ecobee",
		"nestjs",
		"gcloud-pubsub",
		"nodejs",
		"typescript"
	],
	"scripts": {
		"test": "jest",
		"test:ci": "jest --ci --runInBand --reporters=default --reporters=jest-junit --coverage",
		"test:cov": "jest --coverage",
		"test:dev": "jest --watch",
		"build": "rm -rf ./dist && tsc && npm run build:index",
		"build:index": "rm -rf ./index.js ./index.d.ts && tsc -d --skipLibCheck ./index.ts",
		"format": "prettier **/**/*.ts --ignore-path ./.prettierignore --write && git status",
		"prepare": "husky && npm run build"
	},
	"peerDependencies": {
		"@nestjs/common": "^7.4.0 || ^8.1.2 || ^9.0.0 || ^10.0.0 || ^11.0.0",
		"@nestjs/microservices": "^7.4.0 || ^8.1.2 || ^9.0.0 || ^10.0.0 || ^11.0.0"
	},
	"dependencies": {
		"@google-cloud/pubsub": "^6.3.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.4.0"
	},
	"devDependencies": {
		"@nestjs/common": "^11.2.7",
		"@nestjs/core": "^11.2.7",
		"@nestjs/microservices": "^11.2.7",
		"@nestjs/testing": "^11.2.7",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.19.2",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"jest-junit": "^17.0.0",
		"prettier": "^2.8.8",
		"pretty-quick": "^3.3.1",
		"ts-jest": "^29.4.15",
		"typescript": "^5.9.3"
	},
	"jest": {
		"coverageDirectory": "../coverage",
		"collectCoverageFrom": [
			"**/*.ts",
			"!**/*.spec.ts",
			"!**/index.ts",
			"!interfaces/**",
			"!helpers/testHelpers.ts"
		],
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"reporters": [
			"default",
			"jest-junit"
		],
		"rootDir": "src",
		"testRegex": ".spec.ts$",
		"testEnvironment": "node",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		}
	}
}
