{
	"compilerOptions": {
		"moduleResolution": "node",
		"module": "commonjs",
		"declaration": true,
		"noImplicitAny": false,
		"noUnusedLocals": false,
		"removeComments": false,
		"noLib": false,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"target": "es2022",
		"sourceMap": false,
		"allowJs": false,
		"rootDir": "./src",
		"baseUrl": "./",
		"outDir": "./dist",
		"lib": ["es2022", "DOM"]
	},
	"include": ["*.ts", "**/*.ts"],
	"exclude": [
		"./index.ts",
		"./index.d.ts",
		"node_modules",
		"./**/*.spec.ts",
		"examples",
		"src/__tests__"
	]
}
